
.content {
		width: 100vw;
		height: 100vh;
}
.content .background{
		position: fixed;
		z-index: -1;
		width: 100%;
		height: 100%;
		background-size: contain;
}
.contaner{
		position: relative;
		z-index: 1;
		width: 100%;
		height: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
}
.button {
	  display: flex;
	  justify-content: center;
	  align-items: center;
	  height: 15vh;
	  width: 15vh;
	  border-radius: 50%;
	  border: 2px solid black;
	  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); /* 加强阴影效果 */
	  font-size: 36rpx;
	  color: white;
	  transition: all 0.3s ease;
}
.button:hover {
	  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
	   font-size: 40rpx;
	   color: white;
	  text-align: center;/* 加强阴影效果 */
}
.button-create{
		background-color: cadetblue;
}
.button-create:hover{
		background-color: #00aaff; /* 改变背景颜色 */
}
.button-check{
		background-color: chocolate;
}
.button-check:hover{
		background-color: orangered; /* 改变背景颜色 */
}



	
